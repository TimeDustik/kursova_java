# Copy this file to .env and fill in real values before running locally or in Docker.
# NEVER commit .env to version control.

# ===== PostgreSQL =====
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=changeme_strong_password

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/inventory
SPRING_DATASOURCE_USERNAME=inventory
SPRING_DATASOURCE_PASSWORD=changeme_strong_password

# ===== RabbitMQ =====
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ===== JWT =====
# Base64-encoded secret, minimum 256 bits (32 bytes). Generate: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_RANDOM_BASE64_STRING_AT_LEAST_44_CHARS
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ===== AES encryption (license keys) =====
# Exactly 32 ASCII characters = 256-bit key
AES_KEY=REPLACE_WITH_EXACTLY_32_CHAR_KEY_

# ===== App =====
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
