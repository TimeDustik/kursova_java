@startuml IT-Inventory Class Diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageFontSize 13
skinparam arrowColor #555555
skinparam classBackgroundColor #FAFAFA
skinparam classBorderColor #888888

title IT Inventory System — Class Diagram (Patterns highlighted in <<>>)

' ──────────────────── COMMON ───────────────────────────────────────────────────

package "common" {
  abstract class BaseAuditableEntity {
    # createdAt: LocalDateTime
    # updatedAt: LocalDateTime
  }

  class SecurityUtils <<utility>> {
    + {static} getCurrentPrincipal(): Optional<UserPrincipal>
    + {static} getCurrentUserId(): UUID
  }

  interface PermissionEvaluator {
    + hasPermission(auth, targetId, targetType, permission): boolean
  }

  class InventoryPermissionEvaluator <<Strategy>> {
    - equipmentRepository
    - licenseRepository
    + hasPermission(...): boolean
  }
  InventoryPermissionEvaluator ..|> PermissionEvaluator
}

' ──────────────────── USER / SITE ──────────────────────────────────────────────

package "user" {
  class User {
    + id: UUID
    + username: String
    + email: String
    + fullName: String
    + passwordHash: String
    + role: UserRole
    + siteId: UUID
    + active: boolean
  }
  enum UserRole { ADMIN / TEAM_LEAD / WORKER / AUDITOR }
  User --> UserRole
  User --|> BaseAuditableEntity
}

package "site" {
  class Site {
    + id: UUID
    + name: String
    + address: String
    + city: String
    + teamLeadId: UUID
    + createdAt: LocalDateTime
  }
}

' ──────────────────── EQUIPMENT ────────────────────────────────────────────────

package "equipment" {
  class Equipment {
    + id: UUID
    + inventoryNumber: String
    + name: String
    + type: EquipmentType
    + manufacturer: String
    + status: EquipmentStatus
    + purchaseDate: LocalDate
    + warrantyUntil: LocalDate
    + price: BigDecimal
    + siteId: UUID
    + assignedUserId: UUID
  }
  Equipment --|> BaseAuditableEntity

  enum EquipmentType  { LAPTOP / DESKTOP / MONITOR / PHONE / PRINTER / NETWORK / OTHER }
  enum EquipmentStatus { IN_STOCK / ASSIGNED / UNDER_REPAIR / DECOMMISSIONED }
  Equipment --> EquipmentType
  Equipment --> EquipmentStatus

  abstract class EquipmentFactory <<Factory Method>> {
    + {static} forType(type): EquipmentFactory
    + {abstract} createWithDefaults(dto, invNum): Equipment
    # {abstract} defaultWarrantyYears(): int
  }
  class ComputerEquipmentFactory  { # defaultWarrantyYears() = 3 }
  class NetworkEquipmentFactory   { # defaultWarrantyYears() = 5 }
  class DefaultEquipmentFactory   { # defaultWarrantyYears() = 1 }
  EquipmentFactory <|-- ComputerEquipmentFactory
  EquipmentFactory <|-- NetworkEquipmentFactory
  EquipmentFactory <|-- DefaultEquipmentFactory

  class EquipmentSpecification <<Specification>> {
    + {static} hasSiteId(siteId): Specification
    + {static} hasStatus(status): Specification
    + {static} assignedTo(userId): Specification
    + {static} searchQuery(q): Specification
    + {static} from(filter): Specification
  }
}

' ──────────────────── LICENSE ──────────────────────────────────────────────────

package "license" {
  class License {
    + id: UUID
    + softwareName: String
    + vendor: String
    + licenseKey: String <<AES-256-GCM encrypted>>
    + licenseType: LicenseType
    + seatsTotal: int
    + seatsUsed: int
    + expirationDate: LocalDate
    + cost: BigDecimal
    + siteId: UUID
    + hasAvailableSeats(): boolean
  }
  License --|> BaseAuditableEntity

  enum LicenseType { PERPETUAL / SUBSCRIPTION / OEM / VOLUME }
  License --> LicenseType

  class LicenseSpecification <<Specification>> {
    + {static} hasSiteId(siteId): Specification
    + {static} assignedTo(userId): Specification
    + {static} from(filter): Specification
  }
}

' ──────────────────── CRYPTO (Decorator) ──────────────────────────────────────

package "crypto" {
  class LicenseKeyAttributeConverter <<Decorator>> {
    - {static} secretKey: SecretKey
    + convertToDatabaseColumn(key): String
    + convertToEntityAttribute(dbData): String
  }
  class AesKeyHolder {
    + init(): void
  }
  AesKeyHolder --> LicenseKeyAttributeConverter : initialises static key
  License ..> LicenseKeyAttributeConverter : "@Convert"
}

' ──────────────────── AUTH ─────────────────────────────────────────────────────

package "auth" {
  class UserPrincipal {
    + id: UUID
    + username: String
    + role: String
    + siteId: UUID
    + {static} from(user: User): UserPrincipal
    + getAuthorities(): Collection
  }

  class JwtService <<Singleton>> {
    - signingKey: SecretKey
    + generateAccessToken(principal): String
    + extractClaims(token): Claims
    + isValid(token): boolean
  }

  class RefreshToken {
    + token: String
    + userId: UUID
    + expiresAt: LocalDateTime
    + revoked: boolean
    + isValid(): boolean
  }

  class AuthService {
    + login(username, password): AuthResponse
    + refresh(refreshToken): AuthResponse
    + logout(userId): void
  }

  UserPrincipal --> User
  AuthService --> JwtService
  AuthService --> RefreshToken
}

' ──────────────────── AUDIT (Observer) ────────────────────────────────────────

package "audit" {
  class EntityChangedEvent <<ApplicationEvent>> {
    + action: AuditAction
    + entityType: String
    + entityId: String
    + payload: Map
    + actorUserId: UUID
  }

  class AuditLog {
    + id: UUID
    + actorUserId: UUID
    + action: AuditAction
    + entityType: String
    + entityId: String
    + payload: Map <<JSONB>>
    + createdAt: LocalDateTime
  }

  class AuditLogListener <<Observer>> {
    + onEntityChanged(event): void
  }

  enum AuditAction { CREATE / UPDATE / DELETE / ASSIGN / LOGIN / LOGOUT }
  AuditLog --> AuditAction
  AuditLogListener ..> EntityChangedEvent : "@EventListener"
  AuditLogListener --> AuditLog : saves
}

' ──────────────────── NOTIFICATION (Strategy) ─────────────────────────────────

package "notification" {
  interface NotificationStrategy <<Strategy>> {
    + supports(type: NotificationType): boolean
    + send(notification: Notification): void
  }
  class EmailNotificationStrategy
  class InAppNotificationStrategy
  class TelegramNotificationStrategy
  NotificationStrategy <|.. EmailNotificationStrategy
  NotificationStrategy <|.. InAppNotificationStrategy
  NotificationStrategy <|.. TelegramNotificationStrategy

  class NotificationService {
    - strategies: List<NotificationStrategy>
    + process(message): void
  }
  NotificationService --> NotificationStrategy

  class LicenseExpiryScheduler {
    + checkLicenseExpiry(): void
    + checkWarrantyExpiry(): void
  }
}

' ──────────────────── REPORT (Builder) ────────────────────────────────────────

package "report" {
  class EquipmentReportRequest <<Builder>> {
    - siteId: UUID
    - from / to: LocalDate
    - statuses: List
    - types: List
    + {static} builder(): Builder
  }

  class LicenseReportRequest <<Builder>> {
    - siteId: UUID
    - from / to: LocalDate
    - licenseTypes: List
    + {static} builder(): Builder
  }

  class ExcelReportGenerator {
    + generateInventoryReport(siteId): byte[]
    + generateLicenseReport(siteId): byte[]
  }

  class ReportStore <<Singleton>> {
    - store: ConcurrentHashMap
    + save(id, status, content, filename): void
    + get(id): Entry
  }

  class ReportProducer {
    + requestInventoryReport(siteId): UUID
    + requestLicenseReport(siteId): UUID
  }

  class ReportConsumer {
    + consume(message: ReportMessage): void
  }

  ReportConsumer --> ExcelReportGenerator
  ReportConsumer --> ReportStore
  ReportProducer --> ReportStore : PENDING
}

@enduml
